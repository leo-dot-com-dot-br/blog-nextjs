# Simula tempo nas consultas do BD
SIMULATE_WAIT_IN_MS=0
# Tamanho máximo para upload de imagens em bytes
NEXT_PUBLIC_IMAGE_UPLOAD_MAX_SIZE=921600
# Nome da pasta onde as imagens são salvas após upload
IMAGE_UPLOAD_DIRECTORY=uploads
# URL completa do servidor de imagens sem barra final
IMAGE_SERVER_URL='http://localhost:3001'

# Chave usada para assinar os tokens JWT
# src/utils/generate-hashed-password.ts para gerar uma secret key
JWT_SECRET_KEY='SUA_SECRET_KEY'

# Tempo para o login expirar
LOGIN_EXPIRATION_SECONDS=86400
LOGIN_EXPIRATION_STRING='1d'

# Nome do cookie usado para login
LOGIN_COOKIE_NAME='loginSession'

# Nome do usuário para login & hash de senha em base64
LOGIN_USER='SEU_USUÁRIO_DE_ACESSO'
# src/utils/generate-hashed-password.ts para gerar o hash de senha
LOGIN_PASS='SEU_HASH_DE_SENHA'

# Permite ou não o login(0 = Não / 1 = Sim)
ALLOW_LOGIN=1

# URL da API Externa (NestJS)
API_URL='http://localhost:3001'
